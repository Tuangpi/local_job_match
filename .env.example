# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# PostgreSQL (Task: Prisma migrations)
DATABASE_URL=

# Secret used to sign session cookies (Task: auth/sessions)
AUTH_SESSION_SECRET=

# OTP delivery provider (Task: auth/OTP)
OTP_PROVIDER_API_KEY=

# Local file storage for job photos and uploads
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=8
